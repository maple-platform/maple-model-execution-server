FROM maple/runtime-basic:latest

# nnU-Net v2 and TotalSegmentator for segmentation models
RUN pip install --no-cache-dir \
    nnunetv2 \
    TotalSegmentator==2.15.0 \
    opencv-python-headless==4.10.0.84

EXPOSE 8000
CMD ["uvicorn", "app.runtime_server:app", "--host", "0.0.0.0", "--port", "8000"]
